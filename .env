DOCKER_PROJECT_NAME=coreshop-payum-stripe
DOCKER_ALPINE_VERSION=3.23
DOCKER_PHP_VERSION=8.4
DOCKER_BASE_IMAGE=8.0-latest

SYMFONY_ENV=dev
PIMCORE_KERNEL_CLASS=Kernel

# Pimcore 2026.1 configures the default DBAL connection from DATABASE_URL
# (%env(resolve:DATABASE_URL)%); the individual DATABASE_* variables are no
# longer read by Pimcore and only feed the dev-compose database container.
DATABASE_URL=mysql://root:ROOT@database:3306/pimcore
DATABASE_USER=root
DATABASE_PASSWORD=ROOT
DATABASE_NAME=pimcore
DATABASE_HOST=database
DATABASE_PORT=3306

# PIMCORE_OPENSEARCH_DSN lives in .env.dev, not here: Pimcore's installer
# re-reads the .env files with overrideExistingVars, so anything this file
# defines beats the values the Behat CI job exports.
